# attrakttv credentials.
#
# On the deploy host, copy this file to `.env` (in the same folder as
# docker-compose.yml) and fill in the values below. .env is gitignored.
#
# For local dev, you can also export these in ~/.Renviron.

# trakt.tv API (optional for read-only use; tRakt bundles a fallback secret)
trakt_client_id="CLIENT_ID"
trakt_client_secret="CLIENT_SECRET"

# fanart.tv API (required for show poster lookup)
# Get one at https://fanart.tv/get-an-api-key/
fanarttv_api_key="FANARTTV_KEY"
